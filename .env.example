# ⚠ base URL에 /api 포함 여부가 client마다 다름 (docs/mcp-sdk-migration-spec.md §5)
#   - SMELL_ANALYSIS / METRICS : client가 /smell-analyses, /analyses 만 붙임 → /api 포함
#   - ANALYSIS                 : client가 /api/code-analysis 를 붙임      → /api 없이
# 프로덕션(배포 백엔드): https://backend.refactory.store 기준 값을 주석으로 병기

# Code Analysis API (was CODEVI_* in old project)
# 프로덕션: ANALYSIS_API_BASE_URL=https://backend.refactory.store  (/api 없이!)
ANALYSIS_API_BASE_URL=http://localhost:13000
ANALYSIS_API_KEY=
REQUEST_TIMEOUT_MS=15000
LOG_LEVEL=info

# Metrics API (동일 CodeVi backend 13000의 /api — 14000은 옛값)
# 프로덕션: METRICS_API_BASE_URL=https://backend.refactory.store/api
METRICS_API_BASE_URL=http://localhost:13000/api
METRICS_API_KEY=
METRICS_DEFAULT_TEAM_PROJECT_ID=1
METRICS_REQUEST_TIMEOUT_MS=15000

# Smell Analysis API (CodeVi backend smell-analysis domain)
# POST/GET /api/smell-analyses — save_smell_analysis, list_smell_analyses, get_smell_analysis, list_smell_findings
# 프로덕션: SMELL_ANALYSIS_API_BASE_URL=https://backend.refactory.store/api
# API 키 발급: 로그인 후 POST /api/api-keys → cv_live_<48hex>
SMELL_ANALYSIS_API_BASE_URL=http://localhost:13000/api
SMELL_ANALYSIS_API_KEY=
SMELL_ANALYSIS_REQUEST_TIMEOUT_MS=15000

# advanced_pyexamine bridge
# ADVANCED_PYEXAMINE_MODE=cli uses subprocess.
# ADVANCED_PYEXAMINE_MODE=http uses services/advanced-pyexamine HTTP wrapper.
ADVANCED_PYEXAMINE_MODE=cli

# 'false'면 analyze_python_smells 도구를 노출하지 않음 (IDE 등록 시 권장 — 로컬 FS를 읽는 개발용 도구)
ADVANCED_PYEXAMINE_TOOL_ENABLED=true

# 설정 시 http 모드 MCP client가 X-Internal-Token 헤더로 전송하고,
# service는 같은 값을 요구한다 (미설정 시 인증 생략 — 개발 전용)
ADVANCED_PYEXAMINE_SHARED_SECRET=

# service가 분석을 허용하는 루트 디렉토리(comma-separated).
# 미설정 시 ADVANCED_PYEXAMINE_SOURCE_DIR로 대체, 둘 다 없으면 모든 요청 403.
ADVANCED_PYEXAMINE_ALLOWED_ROOTS=

# CLI mode
# Default command is: python -m advanced_pyexamine <projectPath> --json
ADVANCED_PYEXAMINE_BIN=python
ADVANCED_PYEXAMINE_ARGS=-m,advanced_pyexamine
ADVANCED_PYEXAMINE_CWD=
ADVANCED_PYEXAMINE_TIMEOUT_MS=30000

# HTTP mode
ADVANCED_PYEXAMINE_SERVICE_URL=http://localhost:18080
ADVANCED_PYEXAMINE_SERVICE_TIMEOUT_MS=30000

# advanced_pyexamine service runtime / E2E
ADVANCED_PYEXAMINE_SOURCE_DIR=
ADVANCED_PYEXAMINE_SERVICE_HOST=127.0.0.1
ADVANCED_PYEXAMINE_SERVICE_PORT=18080
ADVANCED_PYEXAMINE_E2E_PROJECT_PATH=
ADVANCED_PYEXAMINE_E2E_ONLY=long_method,data_clumps
