# Analysis API (was CODEVI_* in old project)
ANALYSIS_API_BASE_URL=http://localhost:13000/api
REQUEST_TIMEOUT_MS=15000
LOG_LEVEL=info

# Metrics API
METRICS_API_BASE_URL=http://localhost:14000
METRICS_API_KEY=
METRICS_DEFAULT_TEAM_PROJECT_ID=1
METRICS_REQUEST_TIMEOUT_MS=15000

# advanced_pyexamine CLI bridge
# Default command is: python -m advanced_pyexamine <projectPath> --json
ADVANCED_PYEXAMINE_BIN=python
ADVANCED_PYEXAMINE_ARGS=-m,advanced_pyexamine
ADVANCED_PYEXAMINE_CWD=
ADVANCED_PYEXAMINE_TIMEOUT_MS=30000
