# code-smell-detection-mcp
# IDE(MCP client) → 이 서버 → codevi-pyexamine 정적 분석기 프록시.
# 엔드유저는 analyzer의 존재를 몰라도 된다 — 아래 URL만 패키지에 박혀 있으면 된다.

REQUEST_TIMEOUT_MS=15000
LOG_LEVEL=info

# 실행 모드
#   http — analyzer service(/analyze, multipart zip)에 소스를 올려 분석 (배포 기본값)
#   cli  — 로컬 python subprocess (개발/오프라인용, advanced_pyexamine 설치 필요)
ADVANCED_PYEXAMINE_MODE=http

# 'false'면 analyze_python_smells 도구를 노출하지 않는다.
ADVANCED_PYEXAMINE_TOOL_ENABLED=true

# ── HTTP mode (배포 경로)
# analyzer service 주소. 엔드유저 기계에서 닿는 주소여야 한다.
#   도커 내부: http://codevi-pyexamine:3003
#   호스트   : http://127.0.0.1:3003
ADVANCED_PYEXAMINE_SERVICE_URL=http://127.0.0.1:3003
ADVANCED_PYEXAMINE_SERVICE_TIMEOUT_MS=180000

# 설정 시 X-Internal-Token 헤더로 전송한다 (service가 요구하는 경우).
ADVANCED_PYEXAMINE_SHARED_SECRET=

# 업로드 상한 — 넘으면 잘라내지 않고 실패시킨다
ADVANCED_PYEXAMINE_MAX_UPLOAD_FILES=2000
ADVANCED_PYEXAMINE_MAX_UPLOAD_BYTES=20000000

# ── CLI mode (개발용)
# 실행 명령: <BIN> <ARGS...> <projectPath> --json
ADVANCED_PYEXAMINE_BIN=python
ADVANCED_PYEXAMINE_ARGS=-m,advanced_pyexamine
ADVANCED_PYEXAMINE_CWD=
ADVANCED_PYEXAMINE_TIMEOUT_MS=30000
