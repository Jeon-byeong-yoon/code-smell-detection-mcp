{
  "name": "code-smell-detection-mcp",
  "version": "0.2.0",
  "description": "MCP server for static analysis / code smell detection (TypeScript, stdio transport)",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "code-smell-detection-mcp": "dist/server.js"
  },
  "scripts": {
    "test:stdio": "node scripts/stdio-test-client.js",
    "test:advanced-pyexamine": "node scripts/advanced-pyexamine-smoke-test.js",
    "test:advanced-pyexamine:http": "node scripts/advanced-pyexamine-http-smoke-test.js",
    "test:advanced-pyexamine:service": "node scripts/advanced-pyexamine-service-e2e-test.js",
    "test:advanced-pyexamine:compose": "node scripts/advanced-pyexamine-compose-e2e-test.js",
    "test:advanced-pyexamine:errors": "node scripts/advanced-pyexamine-error-cases-test.js",
    "service:advanced-pyexamine": "sh scripts/run-advanced-pyexamine-service.sh",
    "compose:codevi-runtime:config": "docker compose -f docker-compose.codevi-runtime.yml config",
    "compose:codevi-runtime:up": "docker compose -f docker-compose.codevi-runtime.yml up -d --build",
    "compose:codevi-runtime:down": "docker compose -f docker-compose.codevi-runtime.yml down",
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "clean": "rimraf dist"
  },
  "keywords": [
    "mcp",
    "static-analysis",
    "code-smell",
    "pyexamine"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.4.0",
    "dotenv": "^16.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "rimraf": "^4.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
