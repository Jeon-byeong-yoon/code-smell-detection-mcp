{
  "name": "code-smell-detection-mcp",
  "version": "0.3.0",
  "description": "MCP stdio server that proxies IDE requests to the advanced_pyexamine Python code smell analyzer",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "code-smell-detection-mcp": "dist/server.js"
  },
  "scripts": {
    "test:stdio": "node scripts/stdio-test-client.js",
    "test:advanced-pyexamine": "node scripts/advanced-pyexamine-smoke-test.js",
    "test:advanced-pyexamine:http": "node scripts/advanced-pyexamine-http-smoke-test.js",
    "test:advanced-pyexamine:errors": "node scripts/advanced-pyexamine-error-cases-test.js",
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "clean": "rimraf dist"
  },
  "keywords": [
    "mcp",
    "static-analysis",
    "code-smell",
    "pyexamine"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.4.0",
    "dotenv": "^16.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "rimraf": "^4.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
